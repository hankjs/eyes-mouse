{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaze Mouse",
  "version": "0.1.0",
  "identifier": "com.hankjs.gazemouse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gaze Mouse",
        "width": 940,
        "height": 700,
        "minWidth": 600,
        "minHeight": 490,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
